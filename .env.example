# Режим работы (development | production | testing)
ENVIRONMENT=development
DEBUG=True

# Настройки FastAPI
APP_NAME="PNRPU Educational Recommender API"
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Настройки PostgreSQL с pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=recommender_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL для асинхронного подключения SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Пути к нейросетевым моделям
MODEL_NAME="ai-forever/FRIDA"
LOCAL_MODEL_PATH="./models/frida"
EMBEDDING_DIMENSION=1536

# CORS настройки (разрешенные источники для фронтенда)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Настройки планировщика обновлений (ETL Scheduler)
SCHEDULER_ENABLED_BY_DEFAULT=False
SCHEDULER_DEFAULT_INTERVAL_HOURS=168
PIPELINE_LOCK_TIMEOUT_MINUTES=60